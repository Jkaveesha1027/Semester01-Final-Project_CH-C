<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootNode" prefHeight="850.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.chama.controller.RegistrationFormController">
   <children>
      <ImageView fitHeight="792.0" fitWidth="926.0" opacity="0.82">
         <image>
            <Image url="@../image/Turquoise Blue Shoes Realistic Product Promotion Facebook Post(1).png" />
         </image>
      </ImageView>
      <ImageView fitHeight="792.0" fitWidth="579.0" layoutX="926.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/Dark modern tech products promo carousel Instagram post (400 x 550 px).png" />
         </image>
      </ImageView>
      <Label layoutX="357.0" layoutY="37.0" prefHeight="66.0" prefWidth="222.0" stylesheets="@../css/sidePane.css" text="Registration" textFill="#05bef3">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <TextField fx:id="txtUserName" layoutX="344.0" layoutY="319.0" onAction="#userNameOnAction" onKeyReleased="#txtUserNameOnKeyAction" prefHeight="44.0" prefWidth="269.0" promptText="\@User Name" style="-fx-background-radius: 5;" />
      <TextField fx:id="txtPassword" layoutX="344.0" layoutY="397.0" onAction="#txtPasswordOnAction" onKeyReleased="#txtPasswordOnKeyAction" prefHeight="44.0" prefWidth="269.0" promptText="\@Password" style="-fx-background-radius: 5;" />
      <JFXButton buttonType="RAISED" layoutX="365.0" layoutY="505.0" onAction="#registrationOnAction" prefHeight="44.0" prefWidth="205.0" style="-fx-background-color: #05BEF3; -fx-background-radius: 20;" text="Register" textFill="WHITE">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </JFXButton>
      <ImageView fitHeight="131.0" fitWidth="152.0" layoutX="378.0" layoutY="139.0" opacity="0.6">
         <image>
            <Image url="@../icon/register.png" />
         </image>
      </ImageView>
      <Label layoutX="14.0" layoutY="728.0" text="Do you have an Account? " />
      <Hyperlink layoutX="537.0" layoutY="725.0" onAction="#logInOnAction" style="-fx-effect: shadow;" text="Log In" />
   </children>
</AnchorPane>
