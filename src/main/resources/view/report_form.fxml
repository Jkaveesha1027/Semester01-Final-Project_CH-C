      <JFXButton buttonType="RAISED" layoutX="473.0" layoutY="431.0" onAction="#btnScanOnAction" prefHeight="40.0" prefWidth="168.0" style="-fx-background-radius: 50;" styleClass="sale" stylesheets="@../css/style.css" text="Scan" textFill="WHITE">
