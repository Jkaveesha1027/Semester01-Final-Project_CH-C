      <JFXButton buttonType="RAISED" layoutX="437.0" layoutY="525.0" onAction="#btnCustomerReportOnAction" prefHeight="40.0" prefWidth="239.0" style="-fx-background-radius: 50;" styleClass="sale" stylesheets="@../css/style.css" text="Cutomer Report" textFill="WHITE">
         <font>
            <Font size="18.0" />
         </font>
      </JFXButton>
      <JFXButton buttonType="RAISED" layoutX="432.0" layoutY="621.0" onAction="#btnStockOnAction" prefHeight="40.0" prefWidth="239.0" style="-fx-background-radius: 50;" styleClass="sale" stylesheets="@../css/style.css" text="Stock Management" textFill="WHITE">
         <font>
            <Font size="18.0" />
         </font>
      </JFXButton>
      <TextField fx:id="txtSearchCustomerTel" layoutX="416.0" layoutY="478.0" onKeyReleased="#txtCustTelOnKeyRelesed" prefHeight="40.0" prefWidth="298.0" promptText="Customer MobileNumber" styleClass="blue-box-text-field" stylesheets="@../css/sidePane.css">
